*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild
.cxx
*.apk
*.aab
*.keystore
!debug.keystore
dist/*.zip

# JVM crash dumps from Gradle/test workers
hs_err_pid*.log
**/hs_err_pid*.log
replay_pid*.log
**/replay_pid*.log

# Catalogue releases built by tools/catalog-publisher. Public, signed data, but binary and
# rebuildable; the publisher seed that signs them must never be anywhere in this repository.
dist/catalogue/
scripts/publish-catalog/.release/
scripts/publish-catalog/catalog.json
# The folders publish-catalog merges, what it writes, and its lock.
scripts/publish-catalog/add/
scripts/publish-catalog/remove/
scripts/publish-catalog/output/
scripts/publish-catalog/published/
scripts/publish-catalog/.publish.lock/

# Temporary test files
temp-fetch/

# The publisher seed itself (see docs/CATALOGUE_P2P.md), wherever it is generated. Whoever holds it
# can sign a catalogue every TORFILX build trusts, so it must never be tracked, even by accident.
*.seed

# This repo is public. Every Markdown file (plans, working notes, reports, runbooks) stays local;
# only the README is published.
*.md
!/README.md
!/scripts/publish-catalog/README.md
