# SHA-256 of the certificate that signs every stable TORFILX release.
#
# CI refuses to publish a 1.0+ release signed by any other certificate: installed apps only accept
# updates signed with the key they were installed with, so this value never changes.
#
# Fill it in once, from the release keystore, on the line below this comment (colons and case do
# not matter):
#
#   keytool -list -v -keystore torfilx-release.jks -alias torfilx | grep SHA256:
#
D0:8A:0B:35:3A:B1:EA:66:67:65:FF:81:94:D8:6D:D2:8E:FC:A8:A8:A4:39:93:15:00:4B:1E:45:3A:FC:0E:22
